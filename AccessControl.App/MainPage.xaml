<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AccessControl.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid>

        <!-- Fondo -->
        <Image Source="bg_image_login.jpg"
               Aspect="AspectFill"
               Opacity="0.4"
               HeightRequest="300"
               HorizontalOptions="Fill"
               VerticalOptions="Start"/>

        <ScrollView>
            <VerticalStackLayout Spacing="25"
                                 Padding="25,50,25,40">

                <!-- HEADER -->
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Textos -->
                    <VerticalStackLayout Grid.Column="0"
                                         VerticalOptions="Center">
                        <Label Text="Bienvenido,"
                               FontSize="16"
                               TextColor="{StaticResource TextSecondary}"/>

                        <Label Text="Residente"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                    </VerticalStackLayout>

                    <!-- Icono Usuario -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            WidthRequest="55"
                            HeightRequest="55"
                            HorizontalOptions="End"
                            StrokeShape="RoundRectangle 27">

                        <Border.Shadow>
                            <Shadow Brush="{StaticResource PrimaryDark}"
                                    Offset="0,8"
                                    Radius="15"
                                    Opacity="0.1"/>
                        </Border.Shadow>

                        <Image Source="user_icon.svg"
                               HeightRequest="40"
                               WidthRequest="40"
                               VerticalOptions="Center"/>
                    </Border>

                </Grid>

                <!-- ACCESO VEHICULAR -->
                <Border Style="{StaticResource CardStyle}">

                    <VerticalStackLayout Spacing="20">

                        <HorizontalStackLayout Spacing="15">
                            <Border Style="{StaticResource IconContainerStyle}">
                                <Image Source="car_icon.svg"
                                       HeightRequest="50"/>
                            </Border>

                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Acceso Vehicular"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>

                                <Label Text="Portón vehicular"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Text="Abrir portón"
                                Clicked="OnPortonVehicularClicked"
                                Style="{StaticResource PrimaryShadowButtonStyle}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ACCESO PEATONAL -->
                <Border Style="{StaticResource CardStyle}">
                    
                    <VerticalStackLayout Spacing="20">

                        <HorizontalStackLayout Spacing="15">
                            <Border Style="{StaticResource IconContainerStyle}">
                                <Image Source="person_icon.svg"
                                       HeightRequest="50"/>
                            </Border>

                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Acceso Principal"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>

                                <Label Text="Puerta peatonal"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Text="Abrir puerta peatonal"
                                Clicked="OnPuertaPeatonalClicked"
                                Style="{StaticResource PrimaryShadowButtonStyle}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- VIGILANCIA -->
                <Border Style="{StaticResource CardStyle}">

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <Border Style="{StaticResource IconContainerStyle}"
                                Margin="0,0,15,0">
                            <Image Source="camera_icon.svg"
                                   HeightRequest="40"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="Vigilancia"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <Label Text="Ver cámaras en vivo"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource PageBackground}"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 20">

                            <ImageButton Source="row_right_icon.svg"
                                         Clicked="OnCamarasVigilanciaClicked"
                                         HeightRequest="30"
                                         WidthRequest="30"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- ALARMA VECINAL -->
                <Border Stroke="Transparent"
                        BackgroundColor="#FFF5F5"
                        Padding="20"
                        Margin="0,15,0,0"
                        StrokeShape="RoundRectangle 30">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlarmaClicked" />
                    </Border.GestureRecognizers>

                    <Border.Shadow>
                        <Shadow Brush="#E53935"
                                Offset="0,10"
                                Radius="20"
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <HorizontalStackLayout Spacing="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">

                        <Image Source="alarma_icon.svg"
                               HeightRequest="40"
                               WidthRequest="40"/>

                        <Label Text="Activar alarma vecinal"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#D32F2F"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>