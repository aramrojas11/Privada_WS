<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AccessControl.App.Views.LoginPage"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E293B" Offset="0.0" />
                <GradientStop Color="#0F172A" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="30,80,30,30" VerticalOptions="Center">

                <Label Text="Privada Catalanes"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       CharacterSpacing="1.5" />
                <Label Text="Control de Acceso Inteligente"
                       FontSize="14"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"
                       Margin="0,-15,0,30"/>

                <Border Stroke="#334155"
                        StrokeThickness="1"
                        BackgroundColor="#1E293B"
                        Padding="25,35"
                        Margin="0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,15" Radius="30" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="CORREO ELECTRÓNICO" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" />
                            <Border Stroke="#475569" StrokeThickness="1" BackgroundColor="#0F172A" Padding="15,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Placeholder="tu@correo.com"
                                       Text="{Binding Email}"
                                       PlaceholderColor="#64748B"
                                       TextColor="White"
                                       Keyboard="Email"
                                       ClearButtonVisibility="WhileEditing" 
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="CONTRASEÑA" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" />
                            <Border Stroke="#475569" StrokeThickness="1" BackgroundColor="#0F172A" Padding="15,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Placeholder="••••••••"
                                       Text="{Binding Password}"
                                       PlaceholderColor="#64748B"
                                       TextColor="White"
                                       IsPassword="True" 
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="INICIAR SESIÓN"
                                Command="{Binding LoginCommand}"
                                BackgroundColor="#3B82F6"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="14"
                                HeightRequest="55"
                                Margin="0,20,0,0">
                            <Button.Shadow>
                                <Shadow Brush="#3B82F6" Offset="0,8" Radius="20" Opacity="0.5" />
                            </Button.Shadow>
                        </Button>

                        <Label Text="{Binding ErrorMessage}" 
                               TextColor="#EF4444" 
                               HorizontalOptions="Center" 
                               FontSize="13" 
                               Margin="0,10,0,0"
                               IsVisible="{Binding HasError}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>