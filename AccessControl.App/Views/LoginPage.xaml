<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AccessControl.App.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid>
        <!--Fondo-->
        <Image Source="bg_image_login.jpg"
               Aspect="AspectFill"
               Opacity="1.0"
               HorizontalOptions="Fill"
               VerticalOptions="Start"/>
        <ScrollView>
            <!--Logo-->
            <VerticalStackLayout
                Spacing="20"
                Padding="30,60,30,30">
                <Image Source="logo_catalanes.png"
                       HeightRequest="100"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>
                <!--Nombre USUARIO-->
                <Label Text="Bienvenido a&#10;Catalanes"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.1" />
                <!--SUBTITULO-->
                <Label Text="Gestiona tu acceso exclusivo"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       Margin="0,-10,0,20"/>
                
                <!--Input CORREO-->
                <Border Style="{StaticResource InputBorderStyle}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*"
                          Padding="15,0">
                        
                        <!--Icono USUARIO-->
                        <Image Source="user_icon.svg"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center"/>
                        <Entry Grid.Column="1"
                               Placeholder="Correo electrónico"
                               Text="{Binding Email}"
                               Keyboard="Email"/>
                    </Grid>
                </Border>
                <!--INPUT CONTRASEÑA-->
                <Border Style="{StaticResource InputBorderStyle}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="15,0">
                        
                        <!--ICONO CANDADO-->
                        <Image Source="candado_icon.svg"
                               HeightRequest="19"
                               WidthRequest="19"
                               VerticalOptions="Center"/>
                        <Entry
                            x:Name="PasswordEnrty"
                            Grid.Column="1"
                            Placeholder="Contraseña"
                            Text="{Binding Password}"
                            VerticalOptions="Center"
                            IsPassword="True"/>
                        
                        <!--VER CONTRASEÑA-->
                        <ImageButton
                            x:Name="EyeBtn"
                            Grid.Column="2"
                            Source="eye_closed_icon.svg"
                            Clicked="OnEyeClicked"
                            HeightRequest="26"
                            WidthRequest="26" 
                            VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!--CHECKBOX RECORDARME-->
                <HorizontalStackLayout Spacing="10" Margin="5,5,0,5">
                    <CheckBox IsChecked="{Binding Recordarme}" 
                              Color="{StaticResource AccentColor}" />
                    <Label Text="Recordarme" 
                           TextColor="{StaticResource TextSecondary}" 
                           VerticalOptions="Center" 
                           FontSize="14"/>
                </HorizontalStackLayout>

                <!--BOTON INICIO SESION-->
                <Button Text="Iniciar sesión"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,15,0,5">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource AccentColor}"
                                Offset="0,10"
                                Radius="15"
                                Opacity="0.4" />
                    </Button.Shadow>
                </Button>
                
                <!--OLVIDE MI CONTRASEÑA-->
                <Label Text="Olvidé mi contraseña"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextDecorations="Underline"/>
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasError}"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>